# Environment Configuration for Aster & Row Support Agent
APP_ENV=development
LOG_LEVEL=INFO

# Paths (defaults are relative to project root)
KNOWLEDGE_BASE_DIR=knowledge-base
DATA_DIR=data
ORDERS_FILE=data/orders.json
EVALUATION_DIR=evaluation

# Retrieval Configuration
RETRIEVAL_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# LLM Provider Configuration (Groq two-model fallback chain)
LLM_PROVIDER=groq

# Primary Provider: Groq (openai/gpt-oss-120b)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Fallback Provider: Groq (openai/gpt-oss-20b)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional / Dormant Providers
GEMINI_API_KEY=
GEMINI_LLM_MODEL=models/gemini-flash-latest

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
