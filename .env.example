# ==============================================================================
# Aster & Row Customer Support Agent - Environment Configuration Template
# ==============================================================================

# Application environment mode (development, test, production)
APP_ENV=development

# Application log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Comma-separated list of allowed origins for FastAPI CORS middleware
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base directory paths relative to project root
# Directory containing authoritative knowledge base markdown files
KNOWLEDGE_BASE_DIR=knowledge-base

# Directory containing store data assets
DATA_DIR=data

# Path to the orders database/mock JSON file
ORDERS_FILE=data/orders.json

# Directory containing evaluation datasets, harnesses, and benchmarks
EVALUATION_DIR=evaluation

# ==============================================================================
# Retrieval & Search Configuration
# ==============================================================================

# Number of top candidate knowledge chunks to retrieve for evidence pack
RETRIEVAL_TOP_K=8

# BM25 term frequency saturation parameter k1
BM25_K1=1.5

# BM25 document length normalization parameter b
BM25_B=0.75

# Reciprocal Rank Fusion (RRF) smoothing constant k
RRF_K=60

# ==============================================================================
# LLM Provider Configuration
# Supported providers: openrouter, groq, gemini, ollama, mock
# ==============================================================================
LLM_PROVIDER=openrouter

# Toggle complete offline mode using local Ollama (e.g. llama3.1:8b)
# When true, all external API calls are bypassed in favor of local Ollama
OFFLINE_MODE=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==============================================================================
# OpenRouter Configuration (Primary Multi-Model Fallback Chain)
# ==============================================================================

# OpenRouter API authorization key (format: sk-or-v1-...)
OPENROUTER_API_KEY=

# Base URL endpoint for OpenRouter OpenAI-compatible chat completions
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary LLM model identifier on OpenRouter
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct

# Secondary LLM model identifier invoked if primary fails
OPENROUTER_SECONDARY_MODEL=openai/gpt-4o-mini

# Tertiary LLM model identifier invoked if secondary fails
OPENROUTER_TERTIARY_MODEL=mistralai/mistral-small-24b-instruct-2501

# HTTP request timeout in seconds for OpenRouter calls
OPENROUTER_TIMEOUT_SECONDS=30.0

# Maximum number of retry attempts per candidate model
OPENROUTER_MAX_RETRIES=2

# Maximum permitted spend in USD before hard cut-off
OPENROUTER_MAX_COST_USD=3.00

# ==============================================================================
# Groq Provider Configuration (Backup Provider)
# ==============================================================================

# Groq API authorization key (format: gsk_...)
GROQ_API_KEY=

# Primary Groq model identifier
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Fallback Groq model identifier
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Base URL endpoint for Groq OpenAI-compatible API
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ==============================================================================
# Google Gemini Provider Configuration (Legacy)
# ==============================================================================

# Google Gemini / Google AI Studio API key
GEMINI_API_KEY=

# Google Gemini model identifier
GEMINI_LLM_MODEL=models/gemini-flash-latest
